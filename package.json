{
  "name": "street-imagery-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter preview dev",
    "build": "bun run --filter preview build",
    "build:packages": "bun run --filter '@osm-editor-kit/street-imagery' build && bun run --filter '@osm-editor-kit/street-imagery-react' build",
    "preview": "bun run --filter preview preview",
    "type-check": "bun run --filter '*' type-check",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs apps packages",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs apps packages",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "test-run": "bun run --filter '*' test-run",
    "check": "bun run --parallel type-check lint format test-run",
    "check-ci": "bun run --parallel type-check lint-check format-check test-run",
    "version-packages": "changeset version",
    "release": "bun run scripts/release.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@clack/prompts": "^1.7.0",
    "@typescript/typescript-darwin-arm64": "^7.0.2",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "9.1.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-config-react-hooks-js": "^1.1.4",
    "oxlint-tsgolint": "7.0.2005",
    "picocolors": "^1.1.1",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@typescript/typescript-linux-x64": "^7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "eslint-plugin-compat"
  ]
}
